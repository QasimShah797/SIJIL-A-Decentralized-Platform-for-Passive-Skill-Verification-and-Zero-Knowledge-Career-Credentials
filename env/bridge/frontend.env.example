# FRONTEND overlays for the local Moodle → hosted Supabase bridge.
# Merge into .env.local (gitignored) or export before `npm run dev`.
#
# Keep existing hosted VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY.
# Only Moodle display URL + bridge invoke URL change.

# Filter/display for Moodle rows — local site, never a token
VITE_MOODLE_SITE_URL=https://sijil-lms.duckdns.org

# Only when Moodle itself is on this computer. Leave unset for https://sijil-lms.duckdns.org.
# VITE_MOODLE_SYNC_BRIDGE_URL=http://127.0.0.1:8787
