# LOCAL BRIDGE: moodle-sync process on this machine
# Copy to env/bridge/moodle-sync.env (gitignored) and fill from backend/.env + Moodle.
#
# Moodle is LOCAL. Supabase is HOSTED.
# Never commit real keys/tokens. Never put these values in VITE_* vars.

# Hosted Supabase (same project as FE/BE). Replace placeholders — do not commit.
SUPABASE_URL=https://nhzvtqpplfruzocframc.supabase.co
SUPABASE_ANON_KEY=<HOSTED_SUPABASE_ANON_KEY_PLACEHOLDER>
SUPABASE_SERVICE_ROLE_KEY=<HOSTED_SUPABASE_SERVICE_ROLE_KEY_PLACEHOLDER>

# Local Moodle identity (must match core_webservice_get_site_info.siteurl)
MOODLE_EXPECTED_SITE_URL=http://localhost:8000

# How this process reaches Moodle (same host when Deno runs on WSL)
MOODLE_BASE_URL=http://127.0.0.1:8000

# Local Moodle webservice token (SIJIL LMS Integration). Never commit.
MOODLE_TOKEN=<LOCAL_MOODLE_TOKEN_PLACEHOLDER>

# Bridge listen port (avoid Moodle's :8000)
MOODLE_SYNC_BRIDGE_PORT=8787
