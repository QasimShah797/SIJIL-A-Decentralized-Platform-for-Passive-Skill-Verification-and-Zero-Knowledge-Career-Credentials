# LOCAL-ONLY env file for: supabase functions serve moodle-sync --env-file env/local/moodle-sync.env
# Copy to env/local/moodle-sync.env (gitignored) and fill placeholders AFTER local
# `supabase start` and after creating a local Moodle webservice token.
#
# Do NOT use hosted Supabase URL or production service_role / anon keys.
# Do NOT run `supabase secrets set` against the hosted project for these values.

# Local Supabase API (CLI defaults). Replace keys after `supabase status`.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=<LOCAL_SUPABASE_ANON_KEY_PLACEHOLDER>
SUPABASE_SERVICE_ROLE_KEY=<LOCAL_SUPABASE_SERVICE_ROLE_KEY_PLACEHOLDER>

# Moodle identity expected from core_webservice_get_site_info.siteurl
MOODLE_EXPECTED_SITE_URL=http://localhost:8000

# Edge/Docker contact URL to reach Moodle on the host.
# WSL2 / Docker Desktop: host.docker.internal is typical.
# If that fails, substitute the host LAN/WSL IP instead (still local-only HTTP).
MOODLE_BASE_URL=http://host.docker.internal:8000

# Local Moodle webservice token for external service "SIJIL LMS Integration"
# (sijil_service). Never commit a real token; never put this in VITE_* vars.
MOODLE_TOKEN=<LOCAL_MOODLE_TOKEN_PLACEHOLDER>
