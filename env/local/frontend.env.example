# LOCAL-ONLY frontend template for Moodle + local Supabase testing.
# Copy to env/local/frontend.env (gitignored) and fill placeholders AFTER
# `supabase start` prints local anon keys.
#
# Do NOT put production / hosted Supabase credentials here.
# Do NOT put MOODLE_TOKEN here.
# Do NOT overwrite the repo root .env.local used for hosted/dev work.
#
# Vite does not load this file automatically. For a Moodle-local session, either:
#   1) Point a disposable shell at these values, or
#   2) Temporarily use a NEW file such as .env.development.local (if it does not
#      already exist) with the same keys — never overwrite an existing .env.local.

VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=<LOCAL_SUPABASE_ANON_KEY_PLACEHOLDER>
VITE_MOODLE_SITE_URL=https://sijil-lms.duckdns.org

# Optional: keep API pointing at local Express if you run it during wallet tests.
VITE_API_BASE_URL=http://localhost:5000/api
