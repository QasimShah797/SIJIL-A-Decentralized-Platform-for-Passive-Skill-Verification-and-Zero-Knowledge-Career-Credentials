# Frontend (Vite). Copy to .env.local — never commit real keys.
# Use the Supabase anon/public JWT only. Do NOT paste service_role here.
# .env.local overrides .env — keep VITE_GITHUB_CLIENT_ID identical in both files.

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_jwt

# Local Express API. Required for credential issue, wallet shares, and ledger verify.
VITE_API_BASE_URL=http://localhost:5000/api

# GitHub OAuth App (same app as backend GITHUB_OAUTH_CLIENT_ID)
# Callback URL must match this value in the GitHub OAuth app settings.
VITE_GITHUB_CLIENT_ID=your_github_oauth_client_id
VITE_GITHUB_REDIRECT_URI=http://localhost:8080/auth/github/callback

# --- Supabase Edge Function secrets (set in Dashboard or CLI; not Vite) ---
# supabase secrets set PRESENTATION_SIGNING_SECRET=your-long-random-secret
# supabase secrets set BACKEND_PUBLIC_URL=http://localhost:5000
# supabase secrets set GITHUB_OAUTH_CLIENT_ID=your_github_oauth_client_id
# supabase secrets set GITHUB_OAUTH_CLIENT_SECRET=your_github_client_secret
# npm run supabase:deploy-github
#
# Practical task AI (at least one provider required):
#   supabase secrets set GEMINI_API_KEY=your_gemini_key
#   supabase secrets set GROQ_API_KEY=your_groq_key
#   supabase secrets set AI_PROVIDERS=groq,gemini
#   supabase secrets set GROQ_MODEL=your_groq_model
#   supabase functions deploy rapid-task
#
# Recruiter shortlist uses the same Gemini key (never a VITE_ var).
# Groq is the fallback when Gemini returns an empty, blocked, or rejected answer.
#   supabase secrets set GEMINI_MODEL=your_gemini_model
#   supabase functions deploy recruiter-match --project-ref YOUR_PROJECT_REF
#
# Moodle LMS — never put MOODLE_TOKEN in frontend .env:
#   supabase secrets set MOODLE_BASE_URL=https://your-moodle.example.com
#   supabase secrets set MOODLE_TOKEN=your_moodle_webservice_token
#   npm run supabase:deploy-moodle
#
# Issuer Ed25519 keys belong in backend/.env (base64 PEMs), not here.
#   cd backend && npm run generate:issuer-key
