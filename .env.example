# Frontend (Vite). Copy to .env.local — never commit real keys.
# Use the Supabase anon/public JWT only. Do NOT paste service_role here.

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_jwt

# Local Express API. Required for credential issue, wallet shares, and ledger verify.
VITE_API_BASE_URL=http://localhost:5000/api

# GitHub OAuth App (same app as backend GITHUB_OAUTH_CLIENT_ID)
VITE_GITHUB_CLIENT_ID=your_github_oauth_client_id
VITE_GITHUB_REDIRECT_URI=http://localhost:8080/auth/github/callback
