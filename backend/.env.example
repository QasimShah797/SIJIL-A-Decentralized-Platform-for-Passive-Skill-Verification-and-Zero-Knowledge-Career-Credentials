# Server
PORT=5000
NODE_ENV=development

# Remote Supabase (same project as frontend VITE_SUPABASE_URL)
# Dashboard → Project Settings → API
SUPABASE_URL=https://nhzvtqpplfruzocframc.supabase.co
SUPABASE_ANON_KEY=your_anon_jwt_key
# service_role — NEVER expose to frontend; required for npm run seed:institution
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

CORS_ORIGIN=http://localhost:8080
FRONTEND_URL=http://localhost:8080

# false (default): req.ip is the TCP peer. Do not enable unless Express sits behind a
# trusted reverse proxy; otherwise clients can spoof X-Forwarded-For.
TRUST_PROXY=false

# HMAC secret for selective-disclosure presentation proofs (min 32 characters).
# Required. Do not reuse SUPABASE_SERVICE_ROLE_KEY. Existing hmac-sha256-2026 shares
# still verify with this same algorithm once the secret is set explicitly.
PRESENTATION_SIGNING_SECRET=

# Ed25519 issuer keys: PKCS#8 private + SPKI public PEM, each base64-encoded.
# Generate with: npm run generate:issuer-key
# openssl alternative is documented in scripts/generate-issuer-key.ts
# Private key is required in production (server exits if missing).
ISSUER_ED25519_PRIVATE_KEY=
ISSUER_ED25519_PUBLIC_KEY=

# GitHub sign-in (same OAuth app as VITE_GITHUB_CLIENT_ID)
GITHUB_OAUTH_CLIENT_SECRET=your_github_oauth_client_secret

# Gmail SMTP — peer review invitation emails
# Use a Google App Password (not your regular Gmail password):
# Google Account → Security → 2-Step Verification → App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-app@gmail.com
SMTP_PASS=your-16-char-app-password
EMAIL_FROM=SIJIL <your-app@gmail.com>

# Apple Wallet (.pkpass) — optional; buttons stay hidden until all four are set
# Requires an Apple Developer account + Pass Type ID certificate. Do not provision here.
APPLE_PASS_CERT=
APPLE_PASS_KEY=
APPLE_PASS_TYPE_ID=
APPLE_PASS_TEAM_ID=
APPLE_PASS_WWDR=
APPLE_PASS_KEY_PASSPHRASE=

# Google Wallet — optional; buttons stay hidden until both are set
# Requires a Google Cloud project with Wallet API + issuer approval. Do not provision here.
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SA_KEY=

# Hyperledger Fabric (test-network). Leave FABRIC_ENABLED=false until the network is up.
# When false, ledger calls throw LedgerDisabledError and the outbox worker is a no-op.
FABRIC_ENABLED=false
# peer0.org1.example.com:7051 from fabric-samples test-network
FABRIC_PEER_ENDPOINT=localhost:7051
FABRIC_MSP_ID=Org1MSP
FABRIC_CHANNEL=sijil
FABRIC_CHAINCODE=credentialanchor
# Optional; defaults to CredentialAnchor
FABRIC_CONTRACT_NAME=CredentialAnchor
# Paths to local identity files (never commit the files or paste PEM contents here)
FABRIC_CERT_PATH=../fabric/fabric-samples/test-network/organizations/peerOrganizations/org1.example.com/users/Admin@org1.example.com/msp/signcerts/cert.pem
FABRIC_KEY_PATH=../fabric/fabric-samples/test-network/organizations/peerOrganizations/org1.example.com/users/Admin@org1.example.com/msp/keystore/priv_sk
FABRIC_TLS_CERT_PATH=../fabric/fabric-samples/test-network/organizations/peerOrganizations/org1.example.com/peers/peer0.org1.example.com/tls/ca.crt
# Required for the default test-network TLS cert SAN
FABRIC_TLS_OVERRIDE_HOST=peer0.org1.example.com
# Outbox worker
FABRIC_ANCHOR_INTERVAL_MS=15000
FABRIC_ANCHOR_BATCH_SIZE=10
FABRIC_ANCHOR_MAX_ATTEMPTS=8
FABRIC_ANCHOR_BACKOFF_MS=5000
