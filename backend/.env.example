# Server
PORT=5000
NODE_ENV=development

# Remote Supabase (same project as frontend VITE_SUPABASE_URL)
# Dashboard → Project Settings → API
SUPABASE_URL=https://nhzvtqpplfruzocframc.supabase.co
SUPABASE_ANON_KEY=your_anon_jwt_key
# service_role — NEVER expose to frontend; required for npm run seed:institution
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

CORS_ORIGIN=http://localhost:8080
FRONTEND_URL=http://localhost:8080

# GitHub sign-in (same OAuth app as VITE_GITHUB_CLIENT_ID)
GITHUB_OAUTH_CLIENT_SECRET=your_github_oauth_client_secret

# Gmail SMTP — peer review invitation emails
# Use a Google App Password (not your regular Gmail password):
# Google Account → Security → 2-Step Verification → App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-app@gmail.com
SMTP_PASS=your-16-char-app-password
EMAIL_FROM=SIJIL <your-app@gmail.com>

# Apple Wallet (.pkpass) — optional; buttons stay hidden until all four are set
# Requires an Apple Developer account + Pass Type ID certificate. Do not provision here.
APPLE_PASS_CERT=
APPLE_PASS_KEY=
APPLE_PASS_TYPE_ID=
APPLE_PASS_TEAM_ID=
APPLE_PASS_WWDR=
APPLE_PASS_KEY_PASSPHRASE=

# Google Wallet — optional; buttons stay hidden until both are set
# Requires a Google Cloud project with Wallet API + issuer approval. Do not provision here.
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SA_KEY=
